{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write resources/js",
        "format:check": "prettier --check resources/js",
        "lint:php": "cd ../backend && php vendor/bin/pint --test",
        "fix:php": "cd ../backend && php vendor/bin/pint",
        "test": "cd ../backend && php artisan test",
        "check": "npm run format:check && npm run typecheck && npm run check:imports && npm run lint:php && npm run test",
        "typecheck": "tsc --noEmit",
        "check:imports": "node scripts/check-imports.mjs"
    },
    "devDependencies": {
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@types/node": "^26.4.0",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^5.2.0",
        "autoprefixer": "^10.4.12",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "lucide-react": "^1.30.0",
        "postcss": "^8.4.31",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^3.2.1",
        "typescript": "^7.0.2",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "react-router-dom": "^7.18.3"
    }
}
