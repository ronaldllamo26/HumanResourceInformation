APP_NAME=PrimePower
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://core2.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This project runs on PostgreSQL. sqlite is left as the connection here only
# so a fresh clone boots with zero setup; switch to pgsql and fill in real
# credentials (never commit them) to match a real environment.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=primepower_hris
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10
SESSION_IDLE_WARNING=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# These two are a pair, and getting them wrong breaks sign-in with no error
# anywhere — the browser discards a SameSite=None cookie that is not also
# Secure, so the session and XSRF-TOKEN both vanish, every POST 419s, and the
# login screen just reappears. Not even a login_failed audit row is written,
# because authentication is never reached. This cost real time once already.
#
# `none` is only needed to run inside an IDE webview's iframe, and it requires
# HTTPS. On a normal deployment leave SESSION_SAME_SITE=lax and set
# SESSION_SECURE_COOKIE=true (the site is served over TLS either way).
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

# Whose X-Forwarded-* headers to trust. Empty locally — there is no proxy, and
# trusting the header when nobody strips it lets a caller claim any IP. Set to
# `*` on a deployment behind Cloudflare or a host's load balancer, or the audit
# log records the proxy's IP for every sign-in and document read, and the API
# rate limiter drops every tokenless caller into one shared bucket.
TRUSTED_PROXIES=


BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI document scanner — see config/scanner.php.
#
# Every driver is hosted now. There was a local one (Ollama) and it was the
# default, because the image never left the machine; it went because it could
# not run on the server, which made it a privacy control switched off in the
# only place it mattered.
#
# So every scan leaves the country. A 201-file scan is a photograph of
# somebody's PhilSys ID or NBI clearance — under RA 10173 that is a
# cross-border transfer of personal data, and a real deployment needs
# disclosure and consent on file. That is not something these three lines can
# satisfy.
#
# Get a key free at https://aistudio.google.com/apikey. The free tier is about
# 20 scans a day per model — enough to demonstrate the feature, not enough to
# run an HR department on. Past that a scan returns nothing and HR types the
# fields, exactly as before the feature existed.
SCANNER_DRIVER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Whether the batch filer may file a reading nobody looked at. It only does so
# when all six gates in config/scanner.php agree, and it marks every row it
# files — but this is the one switch in the system that lets a model's reading
# become a stored fact, so it is named here rather than left to be discovered
# in config. Set it to false and the batch filer proposes everything and writes
# nothing, exactly as it did before.
SCANNER_AUTOFILE=true

# --- Scanner: Anthropic (paid) ------------------------------------------------
# No free tier, and the accuracy is the reason to pay for it. Like Gemini it is
# a single named processor, which is the thing that makes both easier to
# account for than a broker.
# SCANNER_DRIVER=anthropic
# ANTHROPIC_API_KEY=
# SCANNER_MODEL=claude-opus-5

# --- Scanner: OpenRouter ------------------------------------------------------
# One key, many models — switching model is an env edit rather than a new
# driver, which is what makes this the convenient option for a deployment.
#
# It is a BROKER, not a provider. The image goes to OpenRouter and OpenRouter
# forwards it to whichever upstream is serving that model, so under RA 10173
# this is a cross-border transfer to *two* processors rather than one — and
# which the second is can change without anything here changing. Harder to
# account for than Gemini; the driver sends `data_collection: deny` on every
# request so no upstream retains or trains on the scan.
#
# The model must read images AND honour response_format json_schema. One that
# does neither answers prose, which reaches the form as a blank scan rather
# than as an error — run `php artisan scanner:check` after changing it.
# SCANNER_DRIVER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
