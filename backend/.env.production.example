# =============================================================================
# PRODUCTION environment — PrimePower HRIS (Core Transaction 2)
# =============================================================================
#
# Copy this to `.env` **on the server** and fill in the four bracketed values.
# Do not copy your local .env up: it carries APP_ENV=local, APP_DEBUG=true, a
# database on port 5433, and SESSION_SAME_SITE=none — every one of which is
# either wrong or dangerous in production.
#
# `.env` is gitignored on purpose, which is why this file exists: secrets must
# never travel in the repository, so they are typed once on the server.
#
# Anything marked [FILL IN] you get from the Hostforge control panel or by
# running a command. Everything else is already correct for production.
# -----------------------------------------------------------------------------

APP_NAME=PrimePower

# Not `local`. This one value changes real behaviour in three places:
#   - SecurityHeaders starts sending HSTS (it is suppressed in local)
#   - AppServiceProvider enables the Have-I-Been-Pwned password check
#   - DatabaseSeeder stops issuing the fixed password `password` and generates
#     a distinct random one per login, printed once to the console
APP_ENV=production

# Leave blank and run `php artisan key:generate` on the server.
#
# Back this value up somewhere safe once generated. The government identifiers
# and bank accounts on every employee record are encrypted with it — losing
# APP_KEY means losing that data, not just logging people out.
APP_KEY=

# **The single most important line in this file.** Left true, any error page
# prints a stack trace to the visitor — including the database password, the
# mail password, and the Gemini key, straight out of the environment.
APP_DEBUG=false

APP_TIMEZONE=Asia/Manila
APP_URL=https://core2man.primepowersystem.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# `debug` locally; that writes every query and every mail body to disk, which
# on a system holding salary and government IDs is a log nobody should have.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Database — all four from the Hostforge panel
# -----------------------------------------------------------------------------
# Local development runs Postgres on 5433, which is not a default and will not
# be what the host uses. If the panel offers a socket path rather than a host,
# put it in DB_SOCKET and leave DB_HOST/DB_PORT blank.
DB_CONNECTION=pgsql
DB_HOST=[FILL IN]
DB_PORT=5432
DB_DATABASE=[FILL IN]
DB_USERNAME=[FILL IN]
DB_PASSWORD=[FILL IN]

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
# `database` needs the sessions table, which the users migration creates — so
# `php artisan migrate` covers it. Same for cache and queue below.
SESSION_DRIVER=database
SESSION_LIFETIME=5
SESSION_IDLE_WARNING=60

# On. Session rows live in the database and carry flash messages, including
# the temporary passwords handed out when an account is created or reset —
# unencrypted, those sit in the sessions table as plain text. Turning it on
# signs everybody out once, because existing sessions cannot be decrypted.
SESSION_ENCRYPT=true

SESSION_PATH=/
SESSION_DOMAIN=null

# `lax`, NOT `none`. `none` exists locally only so the app runs inside an IDE
# webview's iframe, and it is the weaker setting — it permits the cookie on
# cross-site requests. Nothing in production needs that.
#
# These two are a pair: a browser silently discards a SameSite=None cookie
# that is not also Secure, which drops the session and XSRF-TOKEN, 419s every
# POST, and makes sign-in look like it does nothing at all — with not even a
# login_failed audit row, because authentication is never reached.
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

# -----------------------------------------------------------------------------
# Behind a proxy — set this, or four audit trails record the wrong IP
# -----------------------------------------------------------------------------
# This domain is Cloudflare-fronted and Hostforge serves from behind its own
# proxy, so without it Laravel reads the *proxy's* address on every request:
#   - every sign-in and failed sign-in is logged against one IP, which is
#     exactly the trail meant to reveal somebody guessing at addresses
#   - every 201-file document read is logged against it (the RA 10173 trail)
#   - the API rate limiter's tokenless fallback keys `ip:` — so the whole
#     internet shares one 20/min bucket instead of one bucket each
#   - $request->secure() stays false, so HSTS never sends and url() emits http
#
# `*` is correct here because the origin is only reachable through the proxy,
# and the proxy overwrites X-Forwarded-For rather than passing a client's own
# value through. It is left empty in .env.example for local, where trusting
# the header would let any caller claim any IP.
TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# Mail — required for password resets
# -----------------------------------------------------------------------------
# Until these work, a forgotten password cannot be reset by the user — an admin
# resets it from Settings > Users & Access instead. Sign-in itself does not
# need mail: people log in with a username and password.
#
# Left as Gmail SMTP because that is what works today. The better answer is a
# mailbox on primepowersystem.com — Cloudflare Email Routing to receive plus a
# sender like Resend — so the system does not send HR mail from a personal
# address. That is a separate job and this file does not block on it.
#
# MAIL_PASSWORD is a Google *app password*, not the account password. If the
# Resend.com SMTP Configuration
# Get your API key from https://resend.com/api-keys
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=re_YOUR_RESEND_API_KEY_HERE
MAIL_ENCRYPTION=ssl
# Default test sender is onboarding@resend.dev. When domain is added, use noreply@yourdomain.com
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="PrimePower Manpower HRIS"


# -----------------------------------------------------------------------------
# Sign-in code (OTP)
# -----------------------------------------------------------------------------
# After the username and password, an account with a personal email connected
# to it on Users & Access is asked for a six-digit code sent to that inbox. The
# company Gmail above is what *sends* it; the inbox it goes to is the account
# holder's own.
#
# OTP_ENABLED=false IS THE WAY BACK IN. There is no terminal on this host and
# no emailed password reset, so a broken mailer plus a required code would lock
# every account out with no recovery at all. If codes stop arriving, set this
# to false in the panel and redeploy: the username and password keep working
# and nobody is stranded. Turn it back on once mail is fixed.
#
# Set MAIL_* above *before* connecting anybody's address, and use the
# "Send test code" button on Users & Access to prove a code really arrives —
# it is the only check that covers both the mailer and the typed address.
OTP_ENABLED=true
OTP_TTL_SECONDS=120
OTP_RESEND_AFTER_SECONDS=45
OTP_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# Document scanner (the one AI feature)
# -----------------------------------------------------------------------------
# The key does not travel with the code — .env is gitignored — so it has to be
# typed here too. Left blank the feature goes dark cleanly: `can.scanDocuments`
# is false, the Scan button is never drawn, and the endpoint 404s. Uploading a
# 201-file document by hand works exactly as before, so a blank key degrades
# the feature rather than breaking a screen.
#
# Free tier is 20 scans a day per model. Get a key at
# https://aistudio.google.com/apikey — and rotate the current one if it has
# been pasted anywhere, including a screenshot.
#
# RA 10173: every scan sends a photograph of somebody's PhilSys ID or NBI
# clearance to Google. That is a cross-border transfer of personal data and
# needs disclosure to the employee and consent on file. There is no longer a
# local driver that avoids this.
SCANNER_DRIVER=gemini
GEMINI_API_KEY=[FILL IN]
GEMINI_MODEL=gemini-3.6-flash

# Tried in order when the model above answers 503. The free tier shares one
# pool per model, so a congested model refuses every retry — a *different*
# model is a different pool, and that is what keeps the scanner working on a
# day like the one that prompted this list. Leave it unset to take the
# defaults in config/scanner.php; `php artisan scanner:check` asks each model
# in turn and prints which ones answer.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3-flash-preview,gemini-3.1-flash-lite

# Built by `cd frontend && npm run build`, which writes into
# backend/public/build. Node is not needed on the server at all — commit the
# built assets and the server just serves them as static files.
VITE_APP_NAME="${APP_NAME}"
